# Maintainer: xifan2333 <xifan233@163.com>
pkgname=webcast-mate
pkgver=0.1.0
pkgrel=1
pkgdesc="Multi-platform live protocol CLI (no browser): login -> go-live RTMP -> live.json"
arch=('x86_64' 'aarch64')
url="https://github.com/xifan2333/webcast-mate"
license=('MIT')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  go build -trimpath -ldflags "-s -w -X main.version=v$pkgver" -o webcast-mate ./cmd/webcast-mate
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 webcast-mate "$pkgdir/usr/bin/webcast-mate"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
